#!/usr/bin/env bash

# Connection-scoped DNS control for the Omarchy network panel. NixOS continues
# to own global resolver and NetworkManager configuration under /etc.
set -euo pipefail
export LC_ALL=C

active_connection() {
  device=$(LC_ALL=C nmcli -t -f DEVICE,TYPE,STATE device status |
    awk -F: '$3 ~ /^connected/ && ($2 == "wifi" || $2 == "ethernet") { print $1; exit }')
  [[ -n ${device:-} ]] || { echo "No active network connection" >&2; exit 1; }

  uuid=$(nmcli -g GENERAL.CON-UUID device show "$device" | head -n1)
  [[ -n $uuid && $uuid != "--" ]] || { echo "No active network profile" >&2; exit 1; }
}

current_provider() {
  local automatic dns
  automatic=$(nmcli -g ipv4.ignore-auto-dns connection show uuid "$uuid")
  dns=$(nmcli -g ipv4.dns connection show uuid "$uuid" | tr '\n' ' ')

  if [[ $automatic != "yes" ]]; then
    echo DHCP
  elif [[ $dns == *"1.1.1.1"* ]]; then
    echo Cloudflare
  elif [[ $dns == *"8.8.8.8"* ]]; then
    echo Google
  else
    echo Custom
  fi
}

apply_dns() {
  local ipv4=$1 ipv6=$2
  nmcli connection modify uuid "$uuid" \
    ipv4.ignore-auto-dns yes ipv4.dns "$ipv4" \
    ipv6.ignore-auto-dns yes ipv6.dns "$ipv6"
}

active_connection
provider=${1:-}

case "$provider" in
  "") current_provider; exit 0 ;;
  DHCP)
    nmcli connection modify uuid "$uuid" \
      ipv4.ignore-auto-dns no ipv4.dns "" \
      ipv6.ignore-auto-dns no ipv6.dns ""
    ;;
  Cloudflare)
    apply_dns "1.1.1.1 1.0.0.1" "2606:4700:4700::1111 2606:4700:4700::1001"
    ;;
  Google)
    apply_dns "8.8.8.8 8.8.4.4" "2001:4860:4860::8888 2001:4860:4860::8844"
    ;;
  Custom)
    printf 'DNS servers (space separated): '
    read -r servers
    [[ -n $servers ]] || exit 1
    ipv4=""
    ipv6=""
    for server in $servers; do
      if [[ $server == *:* ]]; then
        ipv6+="${ipv6:+ }$server"
      else
        ipv4+="${ipv4:+ }$server"
      fi
    done
    apply_dns "$ipv4" "$ipv6"
    ;;
  *) echo "Usage: omarchy-dns [DHCP|Cloudflare|Google|Custom]" >&2; exit 2 ;;
esac

nmcli device reapply "$device" >/dev/null 2>&1 || nmcli connection up uuid "$uuid" >/dev/null
