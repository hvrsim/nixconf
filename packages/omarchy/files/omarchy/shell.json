{
  "version": 1,
  "idle": {
    "screensaver": 0,
    "lock": 0
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.agents",
    "omarchy.battery",
    "omarchy.dev-gallery",
    "omarchy.disk-speedtest",
    "omarchy.dropbox",
    "omarchy.idle",
    "omarchy.monitor",
    "omarchy.nightlight",
    "omarchy.osd",
    "omarchy.polkit",
    "omarchy.reminders",
    "omarchy.tailscale",
    "omarchy.weather"
  ]
}
