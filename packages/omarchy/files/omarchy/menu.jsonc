{
  // Omarchy's first-party Quickshell menu, with only declarative-Nix-safe
  // actions. Package installation, removal, updates, migrations, and setup
  // wizards intentionally belong in the flake rather than a mutable menu.

  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot"]},
  "trigger.capture.area": {"icon":"","label":"Screenshot area","action":"omarchy-screenshot area"},
  "trigger.capture.output": {"icon":"󰍹","label":"Screenshot display","action":"omarchy-screenshot output"},
  "trigger.capture.window": {"icon":"","label":"Screenshot window","action":"omarchy-screenshot window"},
  "trigger.capture.record": {"icon":"","label":"Toggle screen recording","action":"omarchy-screenrecord"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.clipboard": {"icon":"󰅇","label":"Clipboard history","action":"omarchy-shell shell toggle omarchy.clipboard"},
  "trigger.emoji": {"icon":"","label":"Emoji","action":"omarchy-shell shell toggle omarchy.emojis"},
  "trigger.audio": {"icon":"","label":"Audio","action":"omarchy-shell shell toggle omarchy.audio"},
  "trigger.bluetooth": {"icon":"","label":"Bluetooth","action":"omarchy-shell shell toggle omarchy.bluetooth"},
  "trigger.network": {"icon":"󰖩","label":"Network","action":"omarchy-shell shell toggle omarchy.network"},

  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"omarchy-wallpaper-pick"},

  "system.lock": {"icon":"","label":"Lock","action":"omarchy-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","action":"systemctl suspend"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"uwsm stop"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"systemctl reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"systemctl poweroff"},
}
